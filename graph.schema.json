{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dependency Viewer graph, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "nodes", "edges"],
  "properties": {
    "format": { "const": "dependency-viewer" },
    "version": { "const": 1 },
    "name": { "$ref": "#/$defs/text" },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": { "$ref": "#/$defs/text" },
        "line": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["project", "group", "item"] },
        "parent": { "$ref": "#/$defs/text" },
        "sources": { "$ref": "#/$defs/sources" }
      },
      "if": { "properties": { "kind": { "const": "project" } } },
      "then": { "not": { "required": ["parent"] } },
      "else": { "required": ["parent"] }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "kind"],
      "properties": {
        "source": { "$ref": "#/$defs/text" },
        "target": { "$ref": "#/$defs/text" },
        "kind": { "$ref": "#/$defs/text" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    }
  }
}
